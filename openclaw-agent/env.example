# Reference only - NEVER commit real values.
# On the server these live in two places, both outside the repo:
#
# 1) OpenClaw auth / secret stores (write-only, SQLite):
#    Claude subscription token (sk-ant-oat01-..., scope user:inference) - created by:  sudo agent ai claude
TELEGRAM_BOT_TOKEN=           # optional, from @BotFather -> /newbot           (sudo agent secrets telegram)
GEMINI_API_KEY=               # only if you chose the Gemini free tier         (sudo agent ai gemini)
ANTHROPIC_API_KEY=            # only if you chose paid API billing             (sudo agent ai apikey)
#
# 2) /home/openclaw/.openclaw/.env (mode 600) - written by the scripts:
AI_ROUTE=                     # claude-subscription | gemini-free | anthropic-api (written by ai-login.sh)
AI_TOKEN_CREATED=             # date the Claude subscription token was created (renew yearly)
WHATSAPP_OWNER=               # your personal number, E.164 (+9725...)  - only number allowed to talk to the agent
PRIMARY_CHANNEL=              # whatsapp | telegram - where scheduled results & alerts go
TELEGRAM_OWNER_ID=            # your numeric Telegram user id (agent lock <id>)
GOG_ACCOUNT=                  # the Google account connected via: agent google <email> <client_secret.json>
GOG_KEYRING_PASSWORD=         # random, generated by google-auth.sh; encrypts the Google refresh token
AGE_RECIPIENT=                # optional: age public key (age1...) for encrypted off-site backups
ANTHROPIC_ADMIN_KEY=          # optional: sk-ant-admin... shows real Anthropic billing in Control UI -> Usage
