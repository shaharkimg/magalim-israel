// Applied by scripts/google-auth.sh only after a Google account is authorized.
// ${GOG_ACCOUNT} and ${GOG_KEYRING_PASSWORD} come from ~/.openclaw/.env (mode 600).
{
  // Gmail + Calendar through gogcli's typed MCP server (no generic shell).
  // Exposed tools are fixed below; Gmail sending is blocked twice
  // (--gmail-no-send and no --allow-gmail-send). Enabled by scripts/google-auth.sh.
  mcp: {
    servers: {
      google: {
        enabled: true,
        command: "/usr/local/bin/gog",
        args: [
          "--account", "${GOG_ACCOUNT}",
          "--gmail-no-send",
          "--no-input",
          "--wrap-untrusted",
          "mcp",
          "--allow-write",
          "--allow-tool",
          "gmail_search,gmail_get_message,gmail_get_thread,gmail_list_drafts,gmail_get_draft,gmail_list_labels,gmail_create_draft,gmail_update_draft,calendar_events",
        ],
        env: {
          GOG_KEYRING_BACKEND: "file",
          GOG_KEYRING_PASSWORD: "${GOG_KEYRING_PASSWORD}",
        },
        requestTimeoutMs: 60000,
        toolFilter: {
          include: [
            "gmail_search", "gmail_get_message", "gmail_get_thread",
            "gmail_list_drafts", "gmail_get_draft", "gmail_list_labels",
            "gmail_create_draft", "gmail_update_draft", "calendar_events",
          ],
        },
      },
    },
  }
}
